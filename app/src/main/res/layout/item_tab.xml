<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabItemRoot"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:background="#1A1A2E"
    android:layout_marginBottom="6dp">

    <!-- Active indicator bar (left edge) -->
    <View
        android:id="@+id/tabActiveIndicator"
        android:layout_width="3dp"
        android:layout_height="36dp"
        android:background="#6366f1"
        android:layout_marginEnd="12dp"
        android:visibility="invisible" />

    <!-- Globe / favicon placeholder -->
    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="🌐"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginEnd="12dp" />

    <!-- Title + URL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tabItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Tab"
            android:textColor="#E5E7EB"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tabItemUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

    </LinearLayout>

    <!-- Close button -->
    <ImageButton
        android:id="@+id/tabItemClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#6B7280"
        android:contentDescription="Close tab"
        android:padding="8dp" />

</LinearLayout>
