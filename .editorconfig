root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml,xml,gradle}]
indent_size = 2

[*.{java,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew.bat,*.bat}]
end_of_line = crlf
